{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails" ],
    "Properties": {
      "Application": "API"
    }
  },
  "JwtOptions": {
    "Issuer": "Nedesk.NFlow",
    "Audience": "Nedesk.NFlow.Users",
    "ExpiryMinutes": 1440
  },
  "LogFeederOptions": {
    "AllowedLogSensivity": 2 // "Debug"
  },
  "AllowedHosts": "*"
}
